# DESI PRIVAT - Konfigurasi Lingkungan (Hosting & Produksi)
# Sistem Informasi Manajemen Tempat Les Privat

# Kunci Rahasia Sesi (Wajib diganti dengan string acak yang kuat di server hosting)
SECRET_KEY=ganti-dengan-kunci-rahasia-acak-panjang-dan-aman-2026

# Mode Lingkungan (production / development)
FLASK_ENV=production

# Lokasi Database SQLite
DATABASE_PATH=database/desi_privat.db

# Direktori Penyimpanan Backup Otomatis
BACKUP_DIR=backups

# Keamanan Cookie HTTPS (set true jika domain hosting menggunakan SSL/HTTPS)
SESSION_COOKIE_SECURE=false

# Port Aplikasi (opsional)
PORT=5000
